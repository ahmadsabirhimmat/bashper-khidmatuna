PORT=4000
NODE_ENV=development
HOST=0.0.0.0
MONGO_URI=mongodb://127.0.0.1:27017/emergency_contacts
JWT_SECRET=change-me-in-production
# Optional separate secret for CSRF HMAC. Falls back to JWT_SECRET if unset.
# CSRF_SECRET=a-long-random-csrf-secret
# Comma-separated browser origins for admin + provider (required in production)
CLIENT_URL=http://localhost:5175,http://localhost:4175,http://localhost:5176,http://localhost:4176
ADMIN_EMAIL=
# Used only to create the first admin account. Later password changes (forgot-password) live in MongoDB only.
ADMIN_PASSWORD=
ADMIN_FULL_NAME=Emergency Admin
ADMIN_PHONE=
GMAIL_USER=yourgmail@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password
# Render free blocks Gmail SMTP. Use one HTTPS key in production (Brevo recommended):
# BREVO_API_KEY=
# RESEND_API_KEY=
# MAIL_FROM=yourgmail@gmail.com
# true = print OTP in backend terminal (no Gmail). Set false when App Password works.
OTP_DEV_MODE=true
# Public URL of this API (used to build photo links). Render also sets RENDER_EXTERNAL_URL.
# PUBLIC_API_URL=https://bashper-khidmatuna.onrender.com
# Web OAuth client ID from Google Cloud (required for Sign in with Google).
# GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
# Web client secret — server only. Needed to exchange the auth code.
# GOOGLE_CLIENT_SECRET=your-web-client-secret
# CLIENT_URL origins are also the allowed return URLs after Google login on admin/provider.
# Optional Android client ID if the ID token audience is the Android client.
# GOOGLE_ANDROID_CLIENT_ID=your-android-client-id.apps.googleusercontent.com

# --- Production example ---
# NODE_ENV=production
# PORT=4000
# MONGO_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/emergency_contacts
# JWT_SECRET=a-long-random-secret
# CLIENT_URL=https://bashper-khidmatuna-1.onrender.com,https://bashper-khidmatuna-provider.onrender.com
# OTP_DEV_MODE=false
