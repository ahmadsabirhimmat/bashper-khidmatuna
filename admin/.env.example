# Local API (dev)
VITE_API_URL=http://localhost:4000

# Local backend to proxy during `npm run dev`
VITE_API_PROXY_TARGET=http://localhost:4000

# Production build (`npm run build`): set this to the live HTTPS API
# VITE_API_URL=https://api.YOUR-DOMAIN.com

# Set to "true" to skip the Vite dev proxy
# VITE_DISABLE_DEV_PROXY=true

# Override dev/preview ports if needed
# VITE_DEV_SERVER_PORT=5175
# VITE_PREVIEW_PORT=4175

