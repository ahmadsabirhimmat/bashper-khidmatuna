# REST API endpoint (defaults to http://localhost:4000 for local dev)
VITE_API_URL=http://localhost:4000

# Production build (`npm run build`): set this to the live HTTPS API
# VITE_API_URL=https://api.YOUR-DOMAIN.com

# Customize dev/preview ports when running alongside the admin dashboard
# VITE_DEV_SERVER_PORT=5176
# VITE_PREVIEW_PORT=4176

