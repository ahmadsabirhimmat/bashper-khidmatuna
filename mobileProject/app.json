{
  "expo": {
    "name": "Bashper Khidmatuna",
    "slug": "bashper-khidmatuna",
    "owner": "sabirhimmatts-team",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "bashperkhidmatuna",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B254A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "af.bashper.khidmatuna",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "Bashper Khidmatuna uses your location only while the app is open, to sort emergency contacts by the nearest Kandahar district. Location is optional."
      }
    },
    "android": {
      "package": "af.bashper.khidmatuna",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0B254A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0B254A",
          "dark": {
            "image": "./assets/images/splash-icon.png",
            "backgroundColor": "#0B254A"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Bashper Khidmatuna uses your location only while the app is open, to sort emergency contacts by the nearest Kandahar district. Location is optional.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      "expo-font",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "6bd1f059-45eb-4a95-811f-400dc8cbfe40"
      }
    }
  }
}
